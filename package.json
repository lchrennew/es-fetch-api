{
  "name": "es-fetch-api",
  "version": "3.0.0-beta.2",
  "main": "index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./middlewares": {
      "types": "./types/middlewares/index.d.ts",
      "default": "./middlewares/index.js"
    },
    "./middlewares/*.js": {
      "types": "./types/middlewares/*.d.ts",
      "default": "./middlewares/*.js"
    },
    "./middlewares/*": "./middlewares/*"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "http",
    "fetch",
    "axios",
    "es",
    "es6",
    "readability",
    "extensibility"
  ],
  "homepage": "https://lchrennew.github.io/es-fetch-api/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lchrennew/es-fetch-api.git"
  },
  "files": [
    "index.js",
    "fetch.js",
    "helpers/fetcher.js",
    "helpers/index.js",
    "helpers/response.js",
    "middlewares",
    "types",
    "LICENSE"
  ]
}
